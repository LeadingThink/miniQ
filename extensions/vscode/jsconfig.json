{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "types": ["node", "vscode"],
    "moduleResolution": "node"
  },
  "include": ["src/**/*.js", "test/**/*.js"]
}
