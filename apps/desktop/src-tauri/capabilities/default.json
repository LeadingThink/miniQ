{
  "$schema": "https://schema.tauri.app/acl/2",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "vscode://file/*" },
        { "url": "cursor://file/*" },
        { "url": "zed://file/*" }
      ]
    },
    "process:allow-restart",
    "updater:default"
  ]
}
