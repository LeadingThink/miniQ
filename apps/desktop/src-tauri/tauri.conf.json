{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miniQ",
  "version": "0.1.0",
  "identifier": "dev.miniq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "miniQ",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' tauri: ipc: http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/miniq-daemon"]
  }
}
