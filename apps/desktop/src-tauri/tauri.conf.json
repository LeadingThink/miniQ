{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miniQ",
  "version": "0.1.12",
  "identifier": "dev.miniq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "miniQ",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' tauri: ipc: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: tauri: http://127.0.0.1:*; media-src blob:; object-src blob:; frame-src http: https: blob:; font-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "externalBin": ["binaries/miniq-daemon"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5uIHB1YmxpYyBrZXk6IDMwNEYwQ0FGRkM5ODk4NDIKUldSQ21Kajhyd3hQTUVkaFN4M0R5eGdORGVwZmpNc2tsYTRvZ3BZMWxGVGlvNGIwVUVZTzAxUjUK",
      "endpoints": [
        "https://oss.zaiwen.top/releases/miniq/latest.json",
        "https://github.com/LeadingThink/miniQ-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
