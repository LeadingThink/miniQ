{
  "name": "miniq-desktop",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap build android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "release:check-version": "node scripts/check-release-version.mjs",
    "test": "vitest run && npm run test:release-manifest && npm run test:qiniu-publisher",
    "test:release-manifest": "node --test scripts/build-release-manifest.node-test.mjs",
    "test:qiniu-publisher": "python3 scripts/upload_qiniu_release_test.py",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "docx-preview": "^0.4.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^5.4.296",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "subset-font": "^2.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
