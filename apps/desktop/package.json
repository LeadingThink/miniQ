{
  "name": "miniq-desktop",
  "private": true,
  "version": "0.1.26",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prepare:daemon": "node scripts/prepare-daemon-sidecar.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap build android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "release:check-version": "node scripts/check-release-version.mjs",
    "test": "vitest run --maxWorkers=4 --testTimeout=15000 && npm run test:release-manifest && npm run test:qiniu-publisher",
    "test:release-manifest": "node --test scripts/build-release-manifest.node-test.mjs",
    "test:qiniu-publisher": "python3 -m unittest discover -s scripts -p *_test.py",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "csv-parse": "^7.0.2",
    "docx-preview": "^0.4.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^5.4.296",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "subset-font": "^2.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    },
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
